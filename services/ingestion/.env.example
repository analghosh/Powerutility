# Ingestion Service Environment Configuration
# Copy this file to services/ingestion/.env and update the values

# Service Configuration
SERVICE_NAME=ingestion-service
SERVICE_PORT=8002
SERVICE_HOST=0.0.0.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/epms
MONGODB_DATABASE=epms
MONGODB_RAW_DATA_COLLECTION=raw_data
MONGODB_PROCESSED_DATA_COLLECTION=processed_data

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# File Upload Configuration
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=["csv", "json", "xml", "xlsx"]
UPLOAD_DIR=uploads
TEMP_DIR=temp

# Data Processing Configuration
BATCH_SIZE=1000
PROCESSING_TIMEOUT_SECONDS=300
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5

# External API Configuration
EXTERNAL_API_TIMEOUT=30
EXTERNAL_API_RETRY_ATTEMPTS=3
EXTERNAL_API_RETRY_DELAY=1

# Authentication Service
AUTH_SERVICE_URL=https://api-dev.infiscopelabs.com/auth
AUTH_SERVICE_TIMEOUT=10

# Processing Service
PROCESSING_SERVICE_URL=http://localhost:8003
PROCESSING_SERVICE_TIMEOUT=30

# Rate Limiting
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW_SECONDS=3600

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30 