          "Data Processing"
        ],
        "summary": "Process Data",
        "description": "Process data endpoint\n\nReturns:\n    Processing confirmation with transformed data",
        "operationId": "process_data_api_v1_process_data_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessingRequest"
              }
