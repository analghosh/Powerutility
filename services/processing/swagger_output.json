{
  "openapi": "3.1.0",
  "info": {
    "title": "EPMS Processing Service",
    "description": "\n    ## EPMS Processing Service\n    \n    This service handles data processing, transformation, and user management operations.\n    \n    ### Features:\n    - **Data Processing**: Data validation, transformation, and quality assessment\n    - **User Management**: Complete user CRUD operations with RBAC integration\n    - **Role Assignment**: Assign and manage user roles and permissions\n    - **Service Integration**: Communicates with Auth Service for authentication and authorization\n    \n    ### Authentication:\n    All endpoints require authentication using JWT Bearer tokens from the Auth Service.\n    \n    ### User Management:\n    The Processing Service handles all user management operations while delegating authentication to the Auth Service.\n    ",
    "version": "1.0.0"
  },
