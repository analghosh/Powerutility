# Processing Service Environment Configuration
# Copy this file to services/processing/.env and update the values

# Service Configuration
SERVICE_NAME=processing-service
SERVICE_PORT=8003
SERVICE_HOST=0.0.0.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/epms
MONGODB_DATABASE=epms
MONGODB_PROCESSED_DATA_COLLECTION=processed_data
MONGODB_VALIDATION_RULES_COLLECTION=validation_rules
MONGODB_TRANSFORMATION_RULES_COLLECTION=transformation_rules

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=

# Processing Configuration
MAX_CONCURRENT_PROCESSES=4
PROCESSING_TIMEOUT_SECONDS=600
BATCH_SIZE=500
MEMORY_LIMIT_MB=1024

# Validation Configuration
VALIDATION_ENABLED=true
STRICT_VALIDATION=false
ALLOW_PARTIAL_VALIDATION=true

# Transformation Configuration
TRANSFORMATION_ENABLED=true
CACHE_TRANSFORMATIONS=true
TRANSFORMATION_CACHE_TTL=3600

# Data Quality Configuration
DATA_QUALITY_ENABLED=true
MIN_DATA_QUALITY_SCORE=0.8
QUALITY_METRICS=["completeness", "accuracy", "consistency", "timeliness"]

# Authentication Service
AUTH_SERVICE_URL=http://localhost:8001
AUTH_SERVICE_TIMEOUT=10

# Ingestion Service
INGESTION_SERVICE_URL=http://localhost:8002
INGESTION_SERVICE_TIMEOUT=30

# Scheduler Service
SCHEDULER_SERVICE_URL=http://localhost:8004
SCHEDULER_SERVICE_TIMEOUT=10

# Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=3600

# RabbitMQ Configuration
# Defaults to RabbitMQ built-in guest/guest — only override if using custom credentials
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
USE_RABBITMQ_JOBS=true
USE_RABBITMQ_AUDIT=false

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30 