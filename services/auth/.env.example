# Auth Service Environment Configuration
# Copy this file to services/auth/.env and update the values

# Service Configuration
SERVICE_NAME=auth-service
SERVICE_PORT=8001
SERVICE_HOST=0.0.0.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
AUTH_DB_NAME=auth_db
AUDIT_DB_NAME=audit_db
MONGODB_AUTH_COLLECTION=users
MONGODB_SESSIONS_COLLECTION=sessions
MONGODB_AUDIT_COLLECTION=audit_logs

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Redis Blacklist Configuration
REDIS_BLACKLIST_ENABLED=true
REDIS_BLACKLIST_DB=1
REDIS_BLACKLIST_TTL=7

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security Configuration
SECRET_KEY=your-super-secret-key-change-in-production
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600

# MFA Configuration
MFA_ENABLED=true
MFA_ISSUER=EPMS
MFA_ALGORITHM=SHA1
MFA_DIGITS=6
MFA_PERIOD=30

# Session Configuration
SESSION_TIMEOUT_HOURS=24
MAX_SESSIONS_PER_USER=5

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# RabbitMQ Configuration
# Defaults to RabbitMQ built-in guest/guest — only override if using custom credentials
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
USE_RABBITMQ_JOBS=false
USE_RABBITMQ_AUDIT=false

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30

# Default Admin Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@epms.com
ADMIN_INITIAL_PASSWORD=Admin@123 