# Scheduler Service Environment Configuration
# Copy this file to services/scheduler/.env and update the values

# Service Configuration
SERVICE_NAME=scheduler-service
SERVICE_PORT=8004
SERVICE_HOST=0.0.0.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/epms
MONGODB_DATABASE=epms
MONGODB_JOBS_COLLECTION=scheduled_jobs
MONGODB_JOB_HISTORY_COLLECTION=job_history
MONGODB_CRON_JOBS_COLLECTION=cron_jobs

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=3
REDIS_PASSWORD=

# Scheduler Configuration
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT_SECONDS=3600
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY_SECONDS=60

# Cron Configuration
CRON_ENABLED=true
CRON_CHECK_INTERVAL_SECONDS=30
CRON_TIMEZONE=UTC

# Job Types Configuration
DATA_CLEANUP_ENABLED=true
DATA_CLEANUP_RETENTION_DAYS=90
DATA_CLEANUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

RETRY_FAILED_JOBS_ENABLED=true
RETRY_FAILED_JOBS_SCHEDULE="*/15 * * * *"  # Every 15 minutes

PERIODIC_SYNC_ENABLED=true
PERIODIC_SYNC_SCHEDULE="0 */6 * * *"  # Every 6 hours

# Authentication Service
AUTH_SERVICE_URL=http://localhost:8001
AUTH_SERVICE_TIMEOUT=10

# Ingestion Service
INGESTION_SERVICE_URL=http://localhost:8002
INGESTION_SERVICE_TIMEOUT=30

# Processing Service
PROCESSING_SERVICE_URL=http://localhost:8003
PROCESSING_SERVICE_TIMEOUT=30

# Rate Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=3600

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30 