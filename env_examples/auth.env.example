# Auth Service Environment Configuration
# Copy this file to services/auth/.env and update the values

# Service Configuration
SERVICE_NAME=auth-service
SERVICE_PORT=8001
SERVICE_HOST=0.0.0.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
AUTH_DB_NAME=auth_db
AUDIT_DB_NAME=audit_db
MONGODB_AUTH_COLLECTION=users
MONGODB_SESSIONS_COLLECTION=sessions
MONGODB_AUDIT_COLLECTION=audit_logs

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Redis Blacklist Configuration
REDIS_BLACKLIST_ENABLED=true
REDIS_BLACKLIST_DB=1
REDIS_BLACKLIST_TTL=7

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security Configuration
SECRET_KEY=your-super-secret-key-change-in-production
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Password expiry (age = days since the password was last changed)
#   under EXPIRY_DAYS - WARNING_DAYS   normal login
#   from EXPIRY_DAYS - WARNING_DAYS     login plus "your password expires in N days"
#   from EXPIRY_DAYS                    no session until the password is changed
PASSWORD_EXPIRY_DAYS=90
PASSWORD_EXPIRY_WARNING_DAYS=10
# enforce = block expired passwords | warn = only warn | off = no expiry at all
PASSWORD_EXPIRY_MODE=enforce
# Comma-separated roles that never expire; empty = every user, Superadmin included
PASSWORD_EXPIRY_EXEMPT_ROLES=
# Rollout: age is never counted from before this date (YYYY-MM-DD). Set it to the
# deploy date to give every existing account a fresh cycle; leave empty to count
# from each password's real change date (accounts already 90+ days old are blocked
# at their next login until they change it).
PASSWORD_EXPIRY_CLOCK_START=
# Lifetime of the single-use token the expired-password screen uses
PASSWORD_CHANGE_TOKEN_EXPIRE_MINUTES=10
PASSWORD_HISTORY_COUNT=5

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600

# MFA Configuration
MFA_ENABLED=true
MFA_ISSUER=EPMS
MFA_ALGORITHM=SHA1
MFA_DIGITS=6
MFA_PERIOD=30

# Session Configuration
SESSION_TIMEOUT_HOURS=24
MAX_SESSIONS_PER_USER=5

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30

# Default Admin Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@epms.com
ADMIN_INITIAL_PASSWORD=Admin@123 