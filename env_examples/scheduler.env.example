# Scheduler Service Environment Configuration

# Service Configuration
SERVICE_NAME=scheduler-service
SERVICE_PORT=8004
SERVICE_HOST=0.0.0.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/epms
MONGODB_DATABASE=epms
MONGODB_JOBS_COLLECTION=scheduled_jobs
MONGODB_JOB_HISTORY_COLLECTION=job_history
MONGODB_CRON_JOBS_COLLECTION=cron_jobs

# MongoDB Collections for Demand Data Management
MONGODB_DUMMY_COLLECTION=dummy
MONGODB_DEMAND_SERVE_COLLECTION=demand_serve
MONGODB_DEMAND_SERVE_HISTORICAL_COLLECTION=demand_serve_historical

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=3
REDIS_PASSWORD=

# Scheduler Configuration
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT_SECONDS=3600
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY_SECONDS=60

# Cron Configuration
CRON_ENABLED=true
CRON_CHECK_INTERVAL_SECONDS=30
CRON_TIMEZONE=UTC

# Startup Execution Configuration
RUN_ALL_JOBS_ON_STARTUP=true
STARTUP_JOB_DELAY_SECONDS=5
STARTUP_JOB_INTERVAL_SECONDS=2

# Demand Data Management Cron Job
DEMAND_DATA_CRON_ENABLED=true
DEMAND_DATA_CRON_SCHEDULE=0 1 * * *
DEMAND_DATA_CRON_TIMEZONE=UTC

# System Cleanup Configuration
SYSTEM_CLEANUP_ENABLED=true
SYSTEM_CLEANUP_RETENTION_DAYS=90
SYSTEM_CLEANUP_SCHEDULE=0 2 * * *

# Job Execution Logs Lifecycle Configuration
JOB_LOGS_MIGRATION_THRESHOLD_DAYS=7
JOB_LOGS_HISTORICAL_RETENTION_DAYS=60
JOB_LOGS_MIGRATION_SCHEDULE=0 2 * * *
JOB_LOGS_CLEANUP_SCHEDULE=0 3 * * *
JOB_LOGS_MIGRATION_BATCH_SIZE=1000
JOB_LOGS_MIGRATION_TIMEOUT=3600
RETRY_FAILED_JOBS_ENABLED=true
RETRY_FAILED_JOBS_SCHEDULE=*/15 * * * *


# Service URLs
AUTH_SERVICE_URL=http://localhost:8001
AUTH_SERVICE_TIMEOUT=10
INGESTION_SERVICE_URL=http://localhost:8002
INGESTION_SERVICE_TIMEOUT=30
PROCESSING_SERVICE_URL=http://localhost:8003
PROCESSING_SERVICE_TIMEOUT=30

# Rate Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=3600

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30 