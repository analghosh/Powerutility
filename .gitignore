# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/
.env/
# Editor scratch files, not documentation or fixtures.
# These were previously blanket *.md / *.txt / *.json globs misfiled under
# "Virtual environments", which silently hid every new doc and test fixture.
/*.md
!/README.md
/*.txt
!/requirements*.txt
/*.json
*.kiro

# Environment and secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
*.pytest_cache/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
